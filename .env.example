# GEMINI_API_KEY: Server-side API key used by @google/genai to invoke Google Gemma 4 models
# (primary: gemma-4-26b-a4b-it, fallback: gemma-4-31b-it) via the Gemini API.
# Never expose this key to the browser; all model requests run strictly on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional server port (defaults to 3000; Vercel compatible via Number(process.env.PORT) || 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
